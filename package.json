{
  "name": "docker-playwright-demo",
  "version": "1.0.0",
  "description": "A sample Playwright project demonstrating containerized test automation and CI-ready workflows",
  "keywords": [
    "docker",
    "playwright",
    "bdd",
    "typescript",
    "ci",
    "automation testing",
    "allure"
  ],
  "license": "ISC",
  "author": "https://github.com/aldimhernandez",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "npx bddgen && npx playwright test",
    "test:ui": "npx bddgen && npx playwright test --ui",
    "test:tag": "npx bddgen --tags '@tagExample' && npx playwright test",
    "test:debug": "npx bddgen && npx playwright test --verbose",
    "allure:run": "allure run -- npm test",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "allure": "^3.14.3",
    "allure-playwright": "^3.10.2",
    "playwright-bdd": "^9.2.0",
    "tsx": "^4.23.1"
  }
}