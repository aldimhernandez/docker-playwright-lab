{
  "name": "docker-playwright-lab",
  "version": "1.0.0",
  "description": "Hands-on Docker lab using Playwright to explore reproducible development environments, Docker Compose, image publishing, and CI workflows",
  "keywords": [
    "docker",
    "playwright",
    "bdd",
    "typescript",
    "ci",
    "automation testing",
    "allure"
  ],
  "license": "ISC",
  "author": "https://github.com/aldimhernandez",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "npx bddgen && npx playwright test",
    "test:ui": "npx bddgen && npx playwright test --ui",
    "test:tag": "npx bddgen --tags '@tagExample' && npx playwright test",
    "test:debug": "npx bddgen && npx playwright test --verbose",
    "allure:run": "allure run -- npm test",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "allure": "^3.14.3",
    "allure-playwright": "^3.10.2",
    "playwright-bdd": "^9.2.0",
    "tsx": "^4.23.1"
  }
}
